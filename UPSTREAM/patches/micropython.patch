diff --git a/ports/esp32/boards/sdkconfig.base b/ports/esp32/boards/sdkconfig.base
index 6c2198260f52ff3666988b4115e18afb91284004..757948964195653d6a28aac04ae5166b28c43fdd 100644
--- a/ports/esp32/boards/sdkconfig.base
+++ b/ports/esp32/boards/sdkconfig.base
@@ -156,3 +156,26 @@ CONFIG_LWIP_MAX_ACTIVE_TCP=12
 # Enable new I2C slave API, and disable conflict check.
 CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
 CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y
+
+# CSMB Custom settings --------------
+# Performance-oriented XIP from PSRAM
+CONFIG_SPIRAM_XIP_FROM_PSRAM=y
+CONFIG_IDF_EXPERIMENTAL_FEATURES=y
+CONFIG_COMPILER_OPTIMIZATION_PERF=y
+CONFIG_FREERTOS_HZ=1000
+CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
+CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
+CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
+CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
+CONFIG_SPIRAM_IGNORE_NOTFOUND=n
+CONFIG_SPIRAM_RODATA=y
+CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
+# SPIRAM Speed 120M, 80M(Stable)
+CONFIG_SPIRAM_MODE_QUAD=n
+CONFIG_SPIRAM_MODE_OCT=y
+CONFIG_SPIRAM_SPEED_120M=y
+# Cache tuning commonly paired with XIP on S3
+CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
+CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
+CONFIG_ESP32S3_DATA_CACHE_64KB=y
+# CSMB Custom settings --------------
